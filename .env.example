# Copy to .env and fill in. Never commit the real .env.

# Provider selection — one of: anthropic (default) | openrouter | openai-compat
# (alias: openai) | ollama | codex | claude-cli
# Selects which model backend the CLI and server wire at boot. Case-insensitive;
# an unset/empty value defaults to anthropic. An unknown value aborts at boot.
ARDUR_PROVIDER=anthropic

# Anthropic (default) — set ARDUR_PROVIDER=anthropic (or leave it unset)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — set ARDUR_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...

# OpenAI-compatible HTTP endpoints — set ARDUR_PROVIDER=openai-compat
# (alias: openai). Defaults to https://api.openai.com/v1; override the base URL
# for compatible gateways such as local vLLM, LiteLLM, or provider-hosted APIs.
# OPENAI_COMPAT_API_KEY=sk-...             # preferred
# OPENAI_API_KEY=sk-...                    # fallback for OpenAI proper
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_TIMEOUT_SECS=30

# Ollama (local daemon or hosted cloud) — set ARDUR_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434  # local default; cloud is https://ollama.com
# OLLAMA_API_KEY=...                       # cloud only; presence auto-defaults base_url to the cloud

# Codex (ChatGPT subscription via the codex CLI) — set ARDUR_PROVIDER=codex
# CODEX_BINARY=/path/to/codex              # default: searches PATH for `codex`
# CODEX_DEFAULT_MODEL=gpt-5                # default model when a request leaves it unset
# CODEX_SANDBOX_MODE=read-only             # read-only | workspace-write | danger-full-access
# CODEX_WORKING_DIR=/tmp/ardur-codex       # cwd for codex's sandbox

# Claude CLI (Anthropic subscription via the claude/Claude Code CLI) — set
# ARDUR_PROVIDER=claude-cli (alias: claude-subscription). Auth: run `claude login`
# once; usage spends the subscription's Agent SDK Credit pool ($20-$200/mo,
# plan-dependent), NOT unbounded — see crates/provider-claude-cli/README.md.
# CLAUDE_CLI_BINARY=/path/to/claude        # default: searches PATH for `claude`
# CLAUDE_CLI_DEFAULT_MODEL=sonnet          # default model when a request leaves it unset
# CLAUDE_CLI_WORKING_DIR=/tmp/ardur-claude # cwd for the CLI's skill/file context
# CLAUDE_CLI_ALLOWED_TOOLS=                 # --allowedTools value, e.g. "Bash(git *) Edit"
# CLAUDE_CLI_PERMISSION_MODE=default       # default | acceptEdits | auto | bypassPermissions | dontAsk | plan

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_ID=A...

# Matrix channel (second channel adapter, alongside Slack) — opt-in.
# Set ARDUR_CHANNEL_MATRIX=true to start the Matrix bot at boot; the three
# MATRIX_* credentials below are then required (validated at config-load).
# ARDUR_CHANNEL_MATRIX=false
# MATRIX_HOMESERVER_URL=https://matrix.org    # required when enabled
# MATRIX_USER_ID=@ardur-bot:matrix.org         # required when enabled
# MATRIX_ACCESS_TOKEN=syt_...                   # required when enabled (held as a secret)
# MATRIX_DEVICE_ID=ARDUR_BOT                    # recommended: stable id keeps the crypto store
# MATRIX_STATE_DIR=/var/lib/ardur/matrix-state  # default: ~/.ardur/matrix-state (sqlite store)
# MATRIX_AUTO_JOIN_INVITES=false                 # default: false (deny-by-default; opt in explicitly)
# MATRIX_ALLOWED_ROOMS=                          # comma-separated room ids; empty = none allowed (deny-by-default)

# Discord channel (further channel adapter, alongside Slack) — opt-in.
# Set ARDUR_CHANNEL_DISCORD=true to start the Discord bot at boot; the two
# DISCORD_* credentials below are then required (validated at config-load).
# Enable the privileged "Message Content" intent for the bot in the Discord
# developer portal, or inbound message content arrives empty.
# ARDUR_CHANNEL_DISCORD=false
# DISCORD_BOT_TOKEN=...                          # required when enabled (held as a secret)
# DISCORD_APPLICATION_ID=123456789012345678      # required when enabled (== the bot's user id)
# DISCORD_ALLOWED_CHANNELS=                       # comma-separated channel ids; empty = all channels

# Telegram channel (further channel adapter, alongside Slack) — opt-in.
# Set ARDUR_CHANNEL_TELEGRAM=true to start the Telegram bot at boot; the
# TELEGRAM_BOT_TOKEN below is then required (validated at config-load).
# ARDUR_CHANNEL_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...           # required when enabled (held as a secret)
# TELEGRAM_ALLOWED_CHATS=                          # comma-separated chat ids (signed); empty = all chats

# Email channel (further channel adapter, alongside Slack) — opt-in.
# Set ARDUR_CHANNEL_EMAIL=true to start the IMAP poll loop + SMTP sender at
# boot; the four ARDUR_EMAIL_* credentials below are then required (validated
# at config-load). ARDUR_EMAIL_ALLOWED_SENDERS is deny-by-default: an empty
# allowlist drops every inbound message.
# ARDUR_CHANNEL_EMAIL=false
# ARDUR_EMAIL_ADDRESS=bot@example.com            # required when enabled (IMAP/SMTP login + From)
# ARDUR_EMAIL_PASSWORD=...                       # required when enabled (held as a secret; use an app password)
# ARDUR_EMAIL_IMAP_HOST=imap.example.com         # required when enabled
# ARDUR_EMAIL_IMAP_PORT=993                      # default: 993 (implicit TLS)
# ARDUR_EMAIL_SMTP_HOST=smtp.example.com         # required when enabled
# ARDUR_EMAIL_SMTP_PORT=587                      # default: 587 (STARTTLS submission)
# ARDUR_EMAIL_ALLOWED_SENDERS=                    # comma-separated addresses; empty = none allowed (deny-by-default)
# ARDUR_EMAIL_POLL_INTERVAL_SECS=30              # default: 30 (IMAP poll interval, not IDLE — see crate docs)

# PWA surface (installable web-client + Web Push) — opt-in.
# Set ARDUR_PWA_ENABLED=true to mount GET/POST /pwa/* alongside the static
# web-client/ shell. No credentials required: the VAPID keypair is generated
# on first boot and persisted under <ARDUR_DATA_DIR>/pwa/vapid.pem.
# ARDUR_PWA_ENABLED=false

# Ardur
ARDUR_DATA_DIR=/var/lib/ardur
# Bind address: defaults to 127.0.0.1:3000 (loopback only). To accept
# external connections, set to 0.0.0.0:3000 and front with TLS + auth.
ARDUR_BIND_ADDR=127.0.0.1:3000
ARDUR_MODEL=claude-opus-4-8
ARDUR_COST_BUDGET_CENTS=10000
RUST_LOG=info,ardur=debug
ARDUR_LOG_FORMAT=json
# Optional path to a Cedar policy file. Unset (or an absent file) falls back to
# the built-in permissive-but-bounded policy (permit only Action::Submit).
# ARDUR_CEDAR_POLICY_PATH=/etc/ardur/policy.cedar

# ardur CLI (the `ardur chat` binary, not the server) — per-session spend caps.
# ARDUR_CLI_BUDGET_CENTS overrides the per-session ceiling (default 1000 = $10;
# the --budget-cents flag wins over it). ARDUR_CLI_PER_TURN_CENTS caps a single
# turn's reservation so a long session depletes gracefully (default
# min(budget_cents, 100)).
# ARDUR_CLI_BUDGET_CENTS=1000
# ARDUR_CLI_PER_TURN_CENTS=100

# Observability — OpenTelemetry GenAI semantic conventions (off by default).
# When enabled, every provider call emits a `provider.send` span with `gen_ai.*`
# attributes exported over OTLP/gRPC to any OTLP backend (Langfuse / Arize
# Phoenix / Jaeger / Grafana Tempo). See RUN.md "Observability". The two OTEL_*
# vars are the standard OpenTelemetry environment variables.
# ARDUR_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=ardur-agent

# MCP (§6.0) — expose ardur's tools over the Model Context Protocol, and consume
# remote MCP servers. Off by default; when enabled, a bearer allowlist is
# required (the security boundary — front the endpoint with your own TLS/ingress).
ARDUR_MCP_ENABLED=false
# Comma-separated bearer tokens admitted to the MCP routes (required if enabled).
ARDUR_MCP_BEARER_TOKENS=token-one,token-two
# URL path prefix the MCP routes mount under; endpoint is <prefix>/{server_name}.
ARDUR_MCP_PATH_PREFIX=/mcp
# Remote MCP servers to consume tools from (client side): name1=url1,name2=url2.
# Their tools join the runtime's registry and become callable in a turn (§6.0).
# ARDUR_MCP_REMOTE_SERVERS=weather=https://mcp.example.com/mcp/weather

# Skills (§8.X) — load filesystem SKILL.md skills as tools. Comma-separated list
# of directories; each holds <name>/SKILL.md skill folders. Every discovered
# skill registers as a tool (id = its `name`). See examples/skills for fixtures.
# ARDUR_SKILLS_DIRS=./examples/skills,/etc/ardur/skills

# Tool execution (§6.0) — when a completion requests tool calls, the runtime
# invokes them and loops the result back to the model. Both have safe defaults.
# Max provider iterations that may request tools before a turn aborts.
ARDUR_TOOL_MAX_ITERATIONS=5
# Per-tool-call deadline, in seconds.
ARDUR_TOOL_TIMEOUT_SECS=30

# Memory backend — one of: in_memory (default) | qdrant | hybrid
# `in_memory` is the fast in-process store; it is LOST on restart. `qdrant`
# selects the durable, Qdrant-backed store (survives restarts). `hybrid` (§7.0c)
# adds a BM25 lexical index + the embedder over that same durable store for fused
# dense+sparse recall. When `qdrant` OR `hybrid` is selected, QDRANT_URL is
# required; the rest default.
ARDUR_MEMORY=in_memory

# Qdrant (when ARDUR_MEMORY=qdrant or hybrid) — the gRPC endpoint + collection shape.
# QDRANT_URL=http://localhost:6334   # required when ARDUR_MEMORY=qdrant or hybrid
# QDRANT_API_KEY=...                  # omit for an unauthenticated local instance
# QDRANT_COLLECTION=ardur_memory      # default collection name
# QDRANT_VECTOR_DIM=384               # vector dimensionality (match the embedder)
# Under ARDUR_MEMORY=hybrid the BM25 lexical half persists under
# <ARDUR_DATA_DIR>/memory/bm25, so the sparse index survives restarts too.

# Embedding model — the local fastembed model the Qdrant store embeds records and
# queries with (the dense half of hybrid retrieval). One of: bge-small-en-v1.5
# (default, 384-d) | gte-base-en-v1.5 (768-d) | all-minilm-l6-v2 (384-d). The
# collection's vector dim is realigned to the model's dim automatically. The model
# is downloaded once and cached on disk; no API key.
# EMBED_MODEL=bge-small-en-v1.5
